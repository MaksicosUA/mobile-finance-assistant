{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mobile-finance-assistant.local/contracts/home/v1/home.schema.json",
  "title": "Home v1 response",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "generatedAt",
    "dataAsOf",
    "baseCurrency",
    "user",
    "balance",
    "monthSummary",
    "trend",
    "primaryGoal",
    "upcomingPayments",
    "recentTransactions",
    "availableActions",
    "warnings"
  ],
  "properties": {
    "generatedAt": { "$ref": "#/$defs/utcTimestamp" },
    "dataAsOf": { "$ref": "#/$defs/utcTimestamp" },
    "baseCurrency": { "$ref": "#/$defs/currency" },
    "user": {
      "type": "object",
      "additionalProperties": true,
      "required": ["displayName"],
      "properties": {
        "displayName": { "type": "string", "minLength": 1 }
      }
    },
    "balance": {
      "type": "object",
      "additionalProperties": true,
      "required": ["amount", "deltaAmount", "deltaPercent"],
      "properties": {
        "amount": { "$ref": "#/$defs/decimal" },
        "deltaAmount": { "$ref": "#/$defs/decimal" },
        "deltaPercent": { "$ref": "#/$defs/decimal" }
      }
    },
    "monthSummary": {
      "type": "object",
      "additionalProperties": true,
      "required": ["from", "to", "income", "expense", "netFlow"],
      "properties": {
        "from": { "$ref": "#/$defs/date" },
        "to": { "$ref": "#/$defs/date" },
        "income": { "$ref": "#/$defs/decimal" },
        "expense": { "$ref": "#/$defs/decimal" },
        "netFlow": { "$ref": "#/$defs/decimal" }
      }
    },
    "trend": {
      "type": "object",
      "additionalProperties": true,
      "required": ["metric", "period", "total", "points"],
      "properties": {
        "metric": {
          "type": "string",
          "minLength": 1,
          "description": "Open enum. Known v1 values: expense, balance."
        },
        "period": {
          "type": "string",
          "minLength": 1,
          "description": "Open enum. Known v1 values: 7d, 30d."
        },
        "total": { "$ref": "#/$defs/decimal" },
        "points": {
          "type": "array",
          "maxItems": 30,
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["date", "amount"],
            "properties": {
              "date": { "$ref": "#/$defs/date" },
              "amount": { "$ref": "#/$defs/decimal" }
            }
          }
        }
      }
    },
    "primaryGoal": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "id",
            "title",
            "current",
            "target",
            "currency",
            "dueDate",
            "progressPercent",
            "monthlyContribution"
          ],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "title": { "type": "string", "minLength": 1 },
            "current": { "$ref": "#/$defs/decimal" },
            "target": { "$ref": "#/$defs/decimal" },
            "currency": { "$ref": "#/$defs/currency" },
            "dueDate": { "$ref": "#/$defs/date" },
            "progressPercent": { "$ref": "#/$defs/decimal" },
            "monthlyContribution": { "$ref": "#/$defs/decimal" }
          }
        }
      ]
    },
    "upcomingPayments": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id", "title", "dueAt", "amount", "currency", "status"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "dueAt": { "$ref": "#/$defs/utcTimestamp" },
          "amount": { "$ref": "#/$defs/decimal" },
          "currency": { "$ref": "#/$defs/currency" },
          "status": {
            "type": "string",
            "minLength": 1,
            "description": "Open enum. Known v1 values: scheduled, overdue."
          }
        }
      }
    },
    "recentTransactions": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "id",
          "title",
          "category",
          "occurredAt",
          "amount",
          "currency",
          "direction",
          "status"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "category": { "type": "string", "minLength": 1 },
          "occurredAt": { "$ref": "#/$defs/utcTimestamp" },
          "amount": { "$ref": "#/$defs/decimal" },
          "currency": { "$ref": "#/$defs/currency" },
          "direction": {
            "type": "string",
            "minLength": 1,
            "description": "Open enum. Known v1 values: income, expense, transfer."
          },
          "status": {
            "type": "string",
            "minLength": 1,
            "description": "Open enum. Known v1 values: confirmed, pending."
          }
        }
      }
    },
    "availableActions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "description": "Open enum. Known v1 values: voice_entry, analytics, goals, telegram."
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["code", "block"],
        "properties": {
          "code": { "type": "string", "minLength": 1 },
          "block": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": {
    "decimal": {
      "type": "string",
      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "date": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "utcTimestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    }
  }
}
