{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mobile-finance-assistant.local/contracts/finance/v1/account.schema.json",
  "title": "Finance account v1 messages",
  "description": "Strict messages for explicit account bootstrap, deterministic evaluation, idempotent commit, and authoritative account reads.",
  "$defs": {
    "AccountDraft": {
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": "1",
          "title": "Schemaversion",
          "type": "string"
        },
        "commandId": {
          "format": "uuid",
          "title": "Commandid",
          "type": "string"
        },
        "name": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "currency": {
          "maxLength": 3,
          "minLength": 3,
          "pattern": "^[A-Z]{3}$",
          "title": "Currency",
          "type": "string"
        },
        "openingBalance": {
          "description": "Signed finite decimal string; max 20 integer and 18 fraction digits.",
          "maxLength": 40,
          "pattern": "^-?(?:[1-9][0-9]{0,19}(?:\\.[0-9]{1,18})?|0(?:\\.[0-9]{1,18})?)$",
          "title": "Openingbalance",
          "type": "string"
        },
        "openingBalanceOn": {
          "format": "date",
          "formatMaximum": "2100-12-31",
          "formatMinimum": "1900-01-01",
          "title": "Openingbalanceon",
          "type": "string"
        },
        "canonicalTimezone": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Canonicaltimezone",
          "type": "string"
        }
      },
      "required": [
        "schemaVersion",
        "commandId",
        "name",
        "currency",
        "openingBalance",
        "openingBalanceOn",
        "canonicalTimezone"
      ],
      "title": "AccountDraft",
      "type": "object"
    },
    "AccountErrorDetail": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "enum": [
            "MALFORMED_ACCOUNT",
            "CONFIRMATION_MISMATCH",
            "COMMAND_CONFLICT",
            "ACCOUNT_ALREADY_INITIALIZED",
            "ACCOUNT_REJECTED",
            "ACCOUNT_UNAVAILABLE",
            "BASELINE_REJECTED",
            "TIMEZONE_REJECTED",
            "AUTHENTICATION_UNAVAILABLE",
            "FINANCE_PERSISTENCE_UNAVAILABLE"
          ],
          "title": "Code",
          "type": "string"
        },
        "issues": {
          "default": [],
          "items": {
            "$ref": "#/$defs/AccountIssue"
          },
          "title": "Issues",
          "type": "array"
        },
        "baselineIssues": {
          "default": [],
          "items": {
            "$ref": "#/$defs/BaselineIssue"
          },
          "title": "Baselineissues",
          "type": "array"
        },
        "timezoneIssues": {
          "default": [],
          "items": {
            "$ref": "#/$defs/TimezoneIssue"
          },
          "title": "Timezoneissues",
          "type": "array"
        }
      },
      "required": [
        "code"
      ],
      "title": "AccountErrorDetail",
      "type": "object"
    },
    "AccountErrorResponse": {
      "additionalProperties": false,
      "properties": {
        "detail": {
          "$ref": "#/$defs/AccountErrorDetail"
        }
      },
      "required": [
        "detail"
      ],
      "title": "AccountErrorResponse",
      "type": "object"
    },
    "AccountIssue": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "enum": [
            "ACCOUNT_ALREADY_INITIALIZED",
            "OPENING_BALANCE_DATE_IN_FUTURE",
            "UNSUPPORTED_CURRENCY",
            "PROFILE_TIMEZONE_MISMATCH"
          ],
          "title": "Code",
          "type": "string"
        },
        "field": {
          "enum": [
            "account",
            "openingBalanceOn",
            "currency"
          ],
          "title": "Field",
          "type": "string"
        }
      },
      "required": [
        "code",
        "field"
      ],
      "title": "AccountIssue",
      "type": "object"
    },
    "BaselineIssue": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "enum": [
            "BASELINE_NOT_EARLIER",
            "BASELINE_DATE_IN_FUTURE",
            "BASELINE_AFTER_EXISTING_OPERATION"
          ],
          "title": "Code",
          "type": "string"
        },
        "field": {
          "const": "openingBalanceOn",
          "title": "Field",
          "type": "string"
        }
      },
      "required": [
        "code",
        "field"
      ],
      "title": "BaselineIssue",
      "type": "object"
    },
    "CommitAccountRequest": {
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": "1",
          "title": "Schemaversion",
          "type": "string"
        },
        "draft": {
          "$ref": "#/$defs/AccountDraft"
        },
        "draftHash": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[a-f0-9]{64}$",
          "title": "Drafthash",
          "type": "string"
        },
        "confirmedAt": {
          "description": "Timezone-aware instant normalized to UTC.",
          "format": "date-time",
          "formatMaximum": "2100-12-31T23:59:59.999999Z",
          "formatMinimum": "1900-01-01T00:00:00Z",
          "title": "Confirmedat",
          "type": "string"
        }
      },
      "required": [
        "schemaVersion",
        "draft",
        "draftHash",
        "confirmedAt"
      ],
      "title": "CommitAccountRequest",
      "type": "object"
    },
    "CommitAccountResponse": {
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": "1",
          "default": "1",
          "title": "Schemaversion",
          "type": "string"
        },
        "decision": {
          "const": "ACCEPT",
          "default": "ACCEPT",
          "title": "Decision",
          "type": "string"
        },
        "idempotentReplay": {
          "title": "Idempotentreplay",
          "type": "boolean"
        },
        "canonicalTimezone": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Canonicaltimezone",
          "type": "string"
        },
        "timezoneRevision": {
          "const": 1,
          "title": "Timezonerevision",
          "type": "integer"
        },
        "account": {
          "$ref": "#/$defs/CommittedFinanceAccount"
        }
      },
      "required": [
        "idempotentReplay",
        "canonicalTimezone",
        "timezoneRevision",
        "account"
      ],
      "title": "CommitAccountResponse",
      "type": "object"
    },
    "CommitBaselineRequest": {
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": "1",
          "title": "Schemaversion",
          "type": "string"
        },
        "draft": {
          "$ref": "#/$defs/CorrectBaselineDraft"
        },
        "draftHash": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[a-f0-9]{64}$",
          "title": "Drafthash",
          "type": "string"
        },
        "confirmedAt": {
          "description": "Timezone-aware instant normalized to UTC.",
          "format": "date-time",
          "formatMaximum": "2100-12-31T23:59:59.999999Z",
          "formatMinimum": "1900-01-01T00:00:00Z",
          "title": "Confirmedat",
          "type": "string"
        }
      },
      "required": [
        "schemaVersion",
        "draft",
        "draftHash",
        "confirmedAt"
      ],
      "title": "CommitBaselineRequest",
      "type": "object"
    },
    "CommitBaselineResponse": {
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": "1",
          "default": "1",
          "title": "Schemaversion",
          "type": "string"
        },
        "decision": {
          "const": "ACCEPT",
          "default": "ACCEPT",
          "title": "Decision",
          "type": "string"
        },
        "idempotentReplay": {
          "title": "Idempotentreplay",
          "type": "boolean"
        },
        "previousOpeningBalanceOn": {
          "format": "date",
          "formatMaximum": "2100-12-31",
          "formatMinimum": "1900-01-01",
          "title": "Previousopeningbalanceon",
          "type": "string"
        },
        "account": {
          "$ref": "#/$defs/CommittedFinanceAccount"
        }
      },
      "required": [
        "idempotentReplay",
        "previousOpeningBalanceOn",
        "account"
      ],
      "title": "CommitBaselineResponse",
      "type": "object"
    },
    "CommittedFinanceAccount": {
      "additionalProperties": false,
      "properties": {
        "accountId": {
          "format": "uuid",
          "title": "Accountid",
          "type": "string"
        },
        "userId": {
          "format": "uuid",
          "title": "Userid",
          "type": "string"
        },
        "commandId": {
          "format": "uuid",
          "title": "Commandid",
          "type": "string"
        },
        "name": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "currency": {
          "maxLength": 3,
          "minLength": 3,
          "pattern": "^[A-Z]{3}$",
          "title": "Currency",
          "type": "string"
        },
        "openingBalance": {
          "description": "Signed finite decimal string; max 20 integer and 18 fraction digits.",
          "maxLength": 40,
          "pattern": "^-?(?:[1-9][0-9]{0,19}(?:\\.[0-9]{1,18})?|0(?:\\.[0-9]{1,18})?)$",
          "title": "Openingbalance",
          "type": "string"
        },
        "openingBalanceOn": {
          "format": "date",
          "formatMaximum": "2100-12-31",
          "formatMinimum": "1900-01-01",
          "title": "Openingbalanceon",
          "type": "string"
        },
        "openingTimezone": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Openingtimezone",
          "type": "string"
        },
        "status": {
          "const": "active",
          "title": "Status",
          "type": "string"
        },
        "isDefault": {
          "title": "Isdefault",
          "type": "boolean"
        },
        "confirmedAt": {
          "description": "Timezone-aware instant normalized to UTC.",
          "format": "date-time",
          "formatMaximum": "2100-12-31T23:59:59.999999Z",
          "formatMinimum": "1900-01-01T00:00:00Z",
          "title": "Confirmedat",
          "type": "string"
        },
        "createdAt": {
          "description": "Timezone-aware instant normalized to UTC.",
          "format": "date-time",
          "formatMaximum": "2100-12-31T23:59:59.999999Z",
          "formatMinimum": "1900-01-01T00:00:00Z",
          "title": "Createdat",
          "type": "string"
        }
      },
      "required": [
        "accountId",
        "userId",
        "commandId",
        "name",
        "currency",
        "openingBalance",
        "openingBalanceOn",
        "openingTimezone",
        "status",
        "isDefault",
        "confirmedAt",
        "createdAt"
      ],
      "title": "CommittedFinanceAccount",
      "type": "object"
    },
    "CorrectBaselineDraft": {
      "additionalProperties": false,
      "description": "An explicit request to move an account baseline date earlier.",
      "properties": {
        "schemaVersion": {
          "const": "1",
          "title": "Schemaversion",
          "type": "string"
        },
        "commandId": {
          "format": "uuid",
          "title": "Commandid",
          "type": "string"
        },
        "accountId": {
          "format": "uuid",
          "title": "Accountid",
          "type": "string"
        },
        "openingBalanceOn": {
          "format": "date",
          "formatMaximum": "2100-12-31",
          "formatMinimum": "1900-01-01",
          "title": "Openingbalanceon",
          "type": "string"
        }
      },
      "required": [
        "schemaVersion",
        "commandId",
        "accountId",
        "openingBalanceOn"
      ],
      "title": "CorrectBaselineDraft",
      "type": "object"
    },
    "EvaluateAccountRequest": {
      "additionalProperties": false,
      "properties": {
        "draft": {
          "$ref": "#/$defs/AccountDraft"
        }
      },
      "required": [
        "draft"
      ],
      "title": "EvaluateAccountRequest",
      "type": "object"
    },
    "EvaluateAccountResponse": {
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": "1",
          "default": "1",
          "title": "Schemaversion",
          "type": "string"
        },
        "decision": {
          "enum": [
            "REJECT",
            "NEEDS_CONFIRMATION"
          ],
          "title": "Decision",
          "type": "string"
        },
        "draft": {
          "$ref": "#/$defs/AccountDraft"
        },
        "draftHash": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 64,
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Drafthash"
        },
        "issues": {
          "default": [],
          "items": {
            "$ref": "#/$defs/AccountIssue"
          },
          "title": "Issues",
          "type": "array"
        }
      },
      "required": [
        "decision",
        "draft",
        "draftHash"
      ],
      "title": "EvaluateAccountResponse",
      "type": "object"
    },
    "EvaluateBaselineRequest": {
      "additionalProperties": false,
      "properties": {
        "draft": {
          "$ref": "#/$defs/CorrectBaselineDraft"
        }
      },
      "required": [
        "draft"
      ],
      "title": "EvaluateBaselineRequest",
      "type": "object"
    },
    "EvaluateBaselineResponse": {
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": "1",
          "default": "1",
          "title": "Schemaversion",
          "type": "string"
        },
        "decision": {
          "enum": [
            "REJECT",
            "NEEDS_CONFIRMATION"
          ],
          "title": "Decision",
          "type": "string"
        },
        "draft": {
          "$ref": "#/$defs/CorrectBaselineDraft"
        },
        "draftHash": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 64,
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Drafthash"
        },
        "currentOpeningBalanceOn": {
          "format": "date",
          "formatMaximum": "2100-12-31",
          "formatMinimum": "1900-01-01",
          "title": "Currentopeningbalanceon",
          "type": "string"
        },
        "earliestOperationOn": {
          "anyOf": [
            {
              "format": "date",
              "formatMaximum": "2100-12-31",
              "formatMinimum": "1900-01-01",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Earliestoperationon"
        },
        "issues": {
          "default": [],
          "items": {
            "$ref": "#/$defs/BaselineIssue"
          },
          "title": "Issues",
          "type": "array"
        }
      },
      "required": [
        "decision",
        "draft",
        "draftHash",
        "currentOpeningBalanceOn",
        "earliestOperationOn"
      ],
      "title": "EvaluateBaselineResponse",
      "type": "object"
    },
    "ListAccountsResponse": {
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": "1",
          "default": "1",
          "title": "Schemaversion",
          "type": "string"
        },
        "canonicalTimezone": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Canonicaltimezone"
        },
        "timezoneRevision": {
          "minimum": 0,
          "title": "Timezonerevision",
          "type": "integer"
        },
        "accounts": {
          "items": {
            "$ref": "#/$defs/CommittedFinanceAccount"
          },
          "maxItems": 64,
          "title": "Accounts",
          "type": "array"
        }
      },
      "required": [
        "canonicalTimezone",
        "timezoneRevision",
        "accounts"
      ],
      "title": "ListAccountsResponse",
      "type": "object"
    },
    "TimezoneIssue": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "enum": [
            "TIMEZONE_UNCHANGED",
            "TIMEZONE_BEHIND_RECORDED_OPERATIONS"
          ],
          "title": "Code",
          "type": "string"
        },
        "field": {
          "const": "canonicalTimezone",
          "title": "Field",
          "type": "string"
        }
      },
      "required": [
        "code",
        "field"
      ],
      "title": "TimezoneIssue",
      "type": "object"
    }
  },
  "anyOf": [
    {
      "$ref": "#/$defs/EvaluateAccountRequest"
    },
    {
      "$ref": "#/$defs/EvaluateAccountResponse"
    },
    {
      "$ref": "#/$defs/CommitAccountRequest"
    },
    {
      "$ref": "#/$defs/CommitAccountResponse"
    },
    {
      "$ref": "#/$defs/ListAccountsResponse"
    },
    {
      "$ref": "#/$defs/EvaluateBaselineRequest"
    },
    {
      "$ref": "#/$defs/EvaluateBaselineResponse"
    },
    {
      "$ref": "#/$defs/CommitBaselineRequest"
    },
    {
      "$ref": "#/$defs/CommitBaselineResponse"
    },
    {
      "$ref": "#/$defs/AccountErrorResponse"
    }
  ]
}
