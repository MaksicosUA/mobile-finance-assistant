# Copy to .env on the host and fill in. Never commit the filled version.

# The name the certificate is issued for.
MFA_DOMAIN=finance.example.com

# Where the database and the certificates live on the host.
MFA_DATA_ROOT=/mnt/mfa-data

POSTGRES_DB=mfa
POSTGRES_USER=mfa
# Generate: openssl rand -base64 32
POSTGRES_PASSWORD=

# Must match the three above, and must use asyncpg.
MFA_DATABASE_URL=postgresql+asyncpg://mfa:PASSWORD@postgres:5432/mfa

# At least 32 bytes. Generate: openssl rand -base64 48
MFA_AUTH_JWT_SECRET=

# Who may create an account. Unset leaves registration open; empty closes it to
# everyone; a comma-separated list admits exactly those addresses.
MFA_AUTH_REGISTRATION_ALLOWLIST=
