# Copy to .env on the host and fill in. Never commit the filled version.

# The name the certificate is issued for.
MFA_DOMAIN=finance.example.com

# Where the database and the certificates live on the host.
MFA_DATA_ROOT=/mnt/mfa-data

POSTGRES_DB=mfa
POSTGRES_USER=mfa
# Generate: openssl rand -base64 32
POSTGRES_PASSWORD=

# Must match the three above, and must use asyncpg.
MFA_DATABASE_URL=postgresql+asyncpg://mfa:PASSWORD@postgres:5432/mfa

# At least 32 bytes. Generate: openssl rand -base64 48
MFA_AUTH_JWT_SECRET=

# Who may create an account:
#   *                    open to everyone who reaches the host
#   (empty)              closed to everyone
#   a@example.com,b@...  exactly those addresses
# Leaving the line out does NOT open registration here: compose passes an absent
# variable through as an empty string, which is the closed state. `*` beside
# addresses stops the API from starting. Accounts are listed, blocked and erased
# with `python -m mobile_finance_api.account_admin` inside the api container.
MFA_AUTH_REGISTRATION_ALLOWLIST=

# Signs the unauthenticated download links that deliver a first install
# (ADR 0026). Leave empty and no such link works at all — the route answers as
# though nothing were published. At least 32 bytes; generate it on the host:
#   openssl rand -base64 48
# Rotating it withdraws every link ever issued, which is the whole revocation
# story. Never commit a filled value.
MFA_APP_DOWNLOAD_LINK_SECRET=

# Published Android builds are served from $MFA_DATA_ROOT/releases, mounted
# read-only into the API. Nothing has to be set here: the directory may stay
# empty, and a deployment with no build published simply reports no update.
